name: {{ incidentflow_compose_project_name }}
services:
  database:
    image: {{ incidentflow_postgres_image }}
    environment:
      POSTGRES_DB: taskmanager
      POSTGRES_USER: taskmanager
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}
    volumes:
      - task-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U taskmanager -d taskmanager"]
      interval: 5s
      timeout: 3s
      retries: 15
    restart: unless-stopped

  backend:
    image: {{ incidentflow_backend_image }}
    environment:
      DATABASE_URL: postgresql://taskmanager:${POSTGRES_PASSWORD}@database:5432/taskmanager
      NODE_ENV: production
      PORT: 3001
      ADMIN_USERNAME: ${ADMIN_USERNAME:?Set ADMIN_USERNAME in .env}
      ADMIN_PASSWORD: ${ADMIN_PASSWORD:?Set ADMIN_PASSWORD in .env}
    depends_on:
      database:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3001/api/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 5s
      timeout: 4s
      retries: 15
    restart: unless-stopped

  user-frontend:
    image: {{ incidentflow_user_ui_image }}
    ports:
      - "0.0.0.0:8084:80"
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1/api/ready"]
      interval: 5s
      timeout: 4s
      retries: 15
    restart: unless-stopped

  support-frontend:
    image: {{ incidentflow_support_ui_image }}
    ports:
      - "0.0.0.0:8085:80"
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1/api/ready"]
      interval: 5s
      timeout: 4s
      retries: 15
    restart: unless-stopped

  admin-frontend:
    image: {{ incidentflow_admin_ui_image }}
    ports:
      - "0.0.0.0:8086:80"
    depends_on:
      backend:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1/api/ready"]
      interval: 5s
      timeout: 4s
      retries: 15
    restart: unless-stopped

volumes:
  task-data:
